screen Settings:
  username = ""
  email = ""
  dark_mode = false
  notifications = false
  saved = false

  layout vertical, gap: medium, padding: large:
    label "Settings", style: heading
    input bind: username, placeholder: "Username"
    input bind: email, placeholder: "Email"
    toggle bind: dark_mode
    toggle bind: notifications
    button "Save", on tap: save()
    if saved:
      label "Saved!", style: caption

  save():
    saved = true
