shared:
  notes = [
    {title: "Welcome to Boojy Notes", blocks: [
      {type: "heading", content: "Getting started", checked: false},
      {type: "text", content: "A minimal notes app built in Igni for app 2 v1.0 criterion 4 #3.", checked: false},
      {type: "bullet", content: "Tap a note title to view it", checked: false},
      {type: "bullet", content: "Use the buttons below to add blocks", checked: false},
      {type: "checkbox", content: "Tap to toggle me", checked: false}
    ]},
    {title: "Second note", blocks: [
      {type: "heading", content: "A simpler note", checked: false},
      {type: "text", content: "Just one block of text below the heading.", checked: false}
    ]},
    {title: "Third note", blocks: [
      {type: "text", content: "Even simpler. Just text.", checked: false}
    ]}
  ]
  selected_note = null
  font_size = 15

theme:
  color:
    brand: "#80CBC4"
    card: "#1D1E33"
    subtle: "#37474F"

screen Files, title: "Notes":
  layout vertical, padding: large, gap: medium, fill: true, background: black:
    each note in shared.notes:
      layout horizontal, padding: medium, background: card, rounded: medium, on tap: open(note):
        label note.title, color: white
    button "+ New Note", color: brand, on tap: add_note()
    button "Settings", color: subtle, on tap: navigate to Settings

  open(n):
    shared.selected_note = n
    navigate to Note

  add_note():
    note = {title: "Untitled", blocks: [{type: "text", content: "", checked: false}]}
    shared.notes = shared.notes + [note]
    shared.selected_note = note
    navigate to Note

screen Note, title: "Note":
  layout vertical, padding: large, gap: medium, fill: true, background: black:
    button "← Back", color: subtle, on tap: navigate back
    if shared.selected_note is null:
      label "No note selected", color: white
    else:
      label shared.selected_note.title, style: heading, color: white
      each block in shared.selected_note.blocks:
        if block.type is "heading":
          label block.content, style: heading, color: white
        else if block.type is "text":
          label block.content, color: white
        else if block.type is "bullet":
          layout horizontal, gap: small:
            label "•", color: brand
            label block.content, color: white
        else if block.type is "checkbox":
          layout horizontal, gap: small, on tap: toggle_check(block):
            if block.checked:
              label "[x]", color: brand
            else:
              label "[ ]", color: subtle
            label block.content, color: white
      layout horizontal, gap: small:
        button "+ H", color: subtle, on tap: add_block("heading")
        button "+ T", color: subtle, on tap: add_block("text")
        button "+ B", color: subtle, on tap: add_block("bullet")
        button "+ C", color: subtle, on tap: add_block("checkbox")

  add_block(t):
    current = shared.selected_note
    new_block = {type: t, content: "", checked: false}
    updated = {current with blocks: current.blocks + [new_block]}
    shared.notes = replace(shared.notes, current, updated)
    shared.selected_note = updated

  toggle_check(b):
    current = shared.selected_note
    flipped = {b with checked: not b.checked}
    new_blocks = replace(current.blocks, b, flipped)
    updated = {current with blocks: new_blocks}
    shared.notes = replace(shared.notes, current, updated)
    shared.selected_note = updated

screen Settings, title: "Settings":
  layout vertical, padding: large, gap: medium, fill: true, background: black:
    button "← Back", color: subtle, on tap: navigate back
    label "Font size", style: body, color: white
    layout horizontal, gap: medium, align: center:
      slider bind: shared.font_size, min: 10, max: 24
      label shared.font_size, color: white
    label "About", style: body, color: white
    label "Boojy Notes — Igni MVP build", color: white
    label "Built with Igni v0.19.1", color: white
