screen DiceRoller:
  result = 0
  rolled = false

  layout vertical, gap: medium, padding: large, align: center:
    label "Dice Roller", style: heading

    if rolled:
      label "You rolled:", style: body
      label result, style: heading
    else:
      label "Tap Roll to start!", style: body

    button "Roll", on tap: roll()

  roll():
    result = random(1, 6)
    rolled = true
