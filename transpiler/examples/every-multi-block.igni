screen NoteEditor:
  draft = ""
  last_saved = now()
  saved_seconds_ago = 0
  save_count = 0

  every 1s:
    saved_seconds_ago = now() - last_saved

  every 5s:
    save_count = save_count + 1
    last_saved = now()

  every 30s:
    save_count = save_count

  layout vertical, gap: medium, padding: large:
    input bind: draft, placeholder: "Start typing..."
    label saved_seconds_ago
    label save_count
