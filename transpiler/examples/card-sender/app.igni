theme:
  color:
    brand: "#D14545"
    cream: "#FBF3E4"
    sage: "#8FA876"
    surface: "#FBF3E4"
    text: "#3D2E26"
    card: "#FFFFFF"
    subtle: "#A89C8E"
  typography:
    heading: font: pacifico
    body: font: source_sans
  scaffold:
    background: surface
  appbar:
    background: surface
    foreground: text

theme dark:
  color:
    cream: "#1F1812"
    surface: "#1F1812"
    text: "#F5EDE0"
    card: "#2D241D"
    subtle: "#6B6055"
  scaffold:
    background: surface
  appbar:
    background: surface
    foreground: text

shared:
  theme_mode = "system"
  sender_name = ""
  cards = [
    {id: 1, title: "Birthday", occasion: "birthday", bg: "card-birthday.jpg", is_new: true},
    {id: 2, title: "Thank You", occasion: "thank-you", bg: "card-thank-you.jpg", is_new: false},
    {id: 3, title: "Holiday", occasion: "holiday", bg: "card-holiday.jpg", is_new: true},
    {id: 4, title: "Get Well", occasion: "get-well", bg: "card-get-well.jpg", is_new: false},
    {id: 5, title: "Congrats", occasion: "congrats", bg: "card-congrats.jpg", is_new: false},
    {id: 6, title: "Just Because", occasion: "generic", bg: "card-generic.jpg", is_new: true}
  ]
  picked_card = null
  draft_recipient = ""
  draft_message = ""
  draft_accent = "brand"
  send_url = ""
  sent_history = []

screen Home, title: "Cards":
  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    label "Pick a card", style: heading
    label "Tap a design to start customising", style: caption, color: subtle

    each design in shared.cards:
      layout vertical, padding: spacing/4, gap: spacing/2, background: card, rounded: medium, on tap: pick(design):
        layout horizontal, gap: spacing/3:
          label design.title, style: heading.small
          if design.is_new:
            label "NEW!", padding: spacing/1, background: sage, color: cream, rounded: small, style: caption
        label design.occasion, style: caption, color: subtle

    layout horizontal, gap: spacing/3:
      button "History", color: subtle, on tap: navigate to History
      button "Settings", color: subtle, on tap: navigate to Settings

  pick(c):
    shared.picked_card = c
    navigate to Designer

screen Designer, title: "Customise":
  recipient_draft = shared.draft_recipient
  message_draft = shared.draft_message

  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    button "← Back", color: subtle, on tap: navigate back

    layout vertical, padding: spacing/5, gap: spacing/3, background: card, rounded: medium, border: thin:
      label shared.picked_card.title, style: heading, color: shared.draft_accent
      label shared.picked_card.occasion, style: caption, color: subtle

      if shared.draft_recipient is not "":
        label "To " + shared.draft_recipient, style: body
      if shared.draft_message is not "":
        label shared.draft_message, style: body
      if shared.sender_name is not "":
        label "— " + shared.sender_name, style: caption, color: subtle

    label "Recipient", style: heading.small
    input bind: recipient_draft, placeholder: "Who is this for?", on change: shared.draft_recipient = recipient_draft

    label "Message", style: heading.small
    input bind: message_draft, placeholder: "Add a personal touch", on change: shared.draft_message = message_draft

    label "Accent", style: heading.small
    layout horizontal, gap: spacing/3:
      button "Brand red", color: brand, on tap: shared.draft_accent = "brand"
      button "Sage green", color: sage, on tap: shared.draft_accent = "sage"

    button "Preview", color: brand, on tap: navigate to Preview

screen Preview, title: "Preview":
  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    button "← Back", color: subtle, on tap: navigate back

    layout vertical, padding: spacing/6, gap: spacing/4, background: card, rounded: medium:
      label shared.picked_card.title, style: heading, color: shared.draft_accent
      if shared.draft_recipient is not "":
        label "To " + shared.draft_recipient, style: body
      if shared.draft_message is not "":
        label shared.draft_message, style: body
      if shared.sender_name is not "":
        label "— " + shared.sender_name, style: caption, color: subtle

    button "Send →", color: brand, on tap: navigate to Send

screen Send, title: "Send card":
  send_result = fetch(shared.send_url, method: "POST", body: {recipient: shared.draft_recipient, message: shared.draft_message, sender: shared.sender_name, card_id: shared.picked_card.id, card_title: shared.picked_card.title})

  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    button "← Back", color: subtle, on tap: navigate back

    layout vertical, padding: spacing/5, gap: spacing/3, background: card, rounded: medium:
      label shared.picked_card.title, style: heading, color: shared.draft_accent
      if shared.draft_recipient is not "":
        label "To " + shared.draft_recipient, style: body
      if shared.draft_message is not "":
        label shared.draft_message, style: body
      if shared.sender_name is not "":
        label "— " + shared.sender_name, style: caption, color: subtle

    if shared.send_url is "":
      button "Send", color: brand, on tap: shared.send_url = "https://httpbin.org/post"
    else if send_result is loading:
      spinner
      label "Sending…", style: caption, color: subtle
    else if send_result is error:
      label "Send failed", color: brand, style: heading.small
      button "Try again", color: subtle, on tap: shared.send_url = ""
    else:
      label "Sent!", style: heading, color: sage
      button "Done", color: brand, on tap: finalize_send()

  finalize_send():
    entry = {card_id: shared.picked_card.id, card_title: shared.picked_card.title, recipient: shared.draft_recipient, message: shared.draft_message}
    shared.sent_history = shared.sent_history + [entry]
    shared.send_url = ""
    shared.draft_recipient = ""
    shared.draft_message = ""
    navigate to Sent

screen Sent, title: "Sent":
  layout vertical, padding: spacing/6, gap: spacing/4, fill: true, align: center:
    label "Card sent!", style: heading, color: sage
    label "Shareable link generation lands next session.", style: caption, color: subtle
    button "Send another", color: brand, on tap: navigate to Home

screen History, title: "Sent history":
  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    button "← Back", color: subtle, on tap: navigate back

    if shared.sent_history is empty:
      layout vertical, padding: spacing/6, gap: spacing/2, align: center:
        label "No cards sent yet", style: heading.small, color: subtle
        label "Send one from the Home screen", style: caption, color: subtle
    else:
      label "Recently sent", style: heading.small
      each entry in shared.sent_history:
        layout vertical, padding: spacing/4, gap: spacing/2, background: card, rounded: medium:
          label entry.card_title, style: heading.small
          if entry.recipient is not "":
            label "To " + entry.recipient, style: caption, color: subtle
          if entry.message is not "":
            label entry.message, style: caption

screen Settings, title: "Settings":
  sender_draft = shared.sender_name

  layout vertical, padding: spacing/6, gap: spacing/4, fill: true:
    button "← Back", color: subtle, on tap: navigate back

    label "Theme", style: heading.small
    layout vertical, gap: spacing/2:
      button "Follow system", color: brand, on tap: shared.theme_mode = "system"
      button "Light", color: brand, on tap: shared.theme_mode = "light"
      button "Dark", color: brand, on tap: shared.theme_mode = "dark"
      label "Active: " + shared.theme_mode, style: caption, color: subtle

    label "Sender name", style: heading.small
    input bind: sender_draft, placeholder: "Your name on sent cards", on change: shared.sender_name = sender_draft
