{
  "name": "igni-transpiler",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "transpile": "tsx src/cli.ts",
    "igni": "tsx src/igni.ts",
    "test": "bash run-tests.sh",
    "smoke": "bash run-smoke.sh",
    "test:analyze": "bash run-analyze.sh",
    "regen-snapshots": "bash regen-snapshots.sh",
    "dev": "nodemon --ext igni --watch examples --exec 'npx tsx src/cli.ts examples/tutorial.igni > test_app/lib/main.dart && echo Transpiled.'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "sharp": "^0.34.5"
  }
}
