screen AlertDashboard, title: "ALERTS":
    alerts = [
        {level: "critical", message: "Database connection lost"},
        {level: "warning", message: "High memory usage"},
        {level: "critical", message: "API timeout on checkout"},
        {level: "info", message: "New user registered"},
        {level: "warning", message: "Slow query detected"}
    ]

    critical_count = count(alerts, a => a.level is "critical")
    warning_count = count(alerts, a => a.level is "warning")
    info_count = count(alerts, a => a.level is "info")

    summary_text = critical_count + " critical, " + warning_count + " warnings, " + info_count + " info"

    summary_color = green
    if critical_count > 0:
        summary_color = danger
    else if warning_count > 0:
        summary_color = orange

    layout vertical, padding: large, gap: medium:
        label summary_text, style: heading.small, color: summary_color
        divider

        each alert in alerts:
            AlertRow alert, color: severity_color(alert.level)

    severity_color(level):
        if level is "critical":
            return danger
        if level is "warning":
            return orange
        return green

component AlertRow(alert, color):
    layout horizontal, gap: medium, align: center, padding: small:
        badge upper(alert.level), color: color
        label alert.message, style: body
